{
  "info": {
    "name": "UsersAndPosts - Standard Tests",
    "description": "Standard API smoke + auth tests for UsersAndPosts. Run in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Init Test Data",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/users returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const suffix = Date.now().toString();",
              "const username = `pm_user_${suffix}`;",
              "const password = `pm_pass_${suffix}`;",
              "const displayName = `Postman User ${suffix}`;",
              "const content = `Post from Postman ${suffix}`;",
              "",
              "pm.collectionVariables.set('testUsername', username);",
              "pm.collectionVariables.set('testPassword', password);",
              "pm.collectionVariables.set('testDisplayName', displayName);",
              "pm.collectionVariables.set('testPostContent', content);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/users returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('users is an array', function () {",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/posts returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('posts is an array', function () {",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Get DTO Contract",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dtos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/dtos returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('DTO contract has User and Post groups', function () {",
              "  pm.expect(body).to.have.property('User');",
              "  pm.expect(body).to.have.property('Post');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"displayName\": \"{{testDisplayName}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST /api/users returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('createdUserId', String(body.id));",
              "",
              "pm.test('created user has id and expected username', function () {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST /api/auth/login returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('login response matches created user', function () {",
              "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Auth Me (after login)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/auth/me returns 200 after login', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('me endpoint returns session user', function () {",
              "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Create Post (authenticated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"{{testPostContent}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST /api/posts returns 201 when authenticated', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('createdPostId', String(body.id));",
              "pm.test('response includes new post id', function () {",
              "  pm.expect(body.id).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Get User Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{createdUserId}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{createdUserId}}",
            "posts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET /api/users/{id}/posts returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "const postId = Number(pm.collectionVariables.get('createdPostId'));",
              "pm.test('newly created post is in user posts list', function () {",
              "  pm.expect(body.some(p => p.id === postId)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
